# quntumnintent environment template
# Copy to .env and replace the NVIDIA placeholder with your own credential.
# Automatic coaching is intended only for mock interviews/practice or sessions where AI help is explicitly permitted.

# Final answer engine: local Qwen/Ollama only.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
OLLAMA_WARMUP=0
OLLAMA_STREAM_SOCKET_TIMEOUT_SECONDS=60.0
LOCAL_QWEN_FIRST_TOKEN_TIMEOUT_SECONDS=20.0
LOCAL_QWEN_STREAM_IDLE_TIMEOUT_SECONDS=30.0
TEXT_MAX_TOKENS=700
VISION_MAX_TOKENS=1200

# One NVIDIA credential is used for Parakeet ASR and Nemotron Omni image-to-text.
# Never commit a real key. If a key was pasted into chat/source, revoke it and create a new one.
NVIDIA_API_KEY=nvapi-REPLACE-WITH-A-NEW-ROTATED-KEY

# NVIDIA Parakeet CTC 1.1B English streaming ASR.
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_RIVA_LANGUAGE=en-US

# NVIDIA Nemotron 3 Nano Omni image-to-text / visual extraction.
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_VISION_TIMEOUT_SECONDS=30.0
NVIDIA_VISION_POLL_TIMEOUT_SECONDS=40.0
NVIDIA_VISION_POLL_INTERVAL_SECONDS=0.5
NVIDIA_VISION_MAX_TOKENS=1400
NVIDIA_VISION_TEMPERATURE=0.2
NVIDIA_VISION_429_BACKOFF_SECONDS=60.0

# Private candidate/resume/project context.
# Default file is data/candidate_context.local.md and is git-ignored.
CANDIDATE_CONTEXT_FILE=data/candidate_context.local.md
CANDIDATE_CONTEXT_MAX_CHARS=30000

# Visual routing.
# Frames are cached while listening. They are sent to NVIDIA vision only when the spoken
# prompt depends on the screen/camera, or when Capture/Camera is triggered explicitly.
AUTO_VISUAL_ANSWER=1
AUTO_VISUAL_WHILE_LISTENING=0
VISUAL_AUTO_ANSWER_COOLDOWN_SECONDS=4.0

# Low-latency speech endpointing.
ASR_ENDPOINT_SECONDS=0.35
ASR_VAD_THRESHOLD=0.005
ASR_MAX_UTTERANCE_SECONDS=30

# Windows default-speaker loopback capture rate for browser/video/meeting audio.
WASAPI_LOOPBACK_SAMPLE_RATE=48000

TRANSCRIPT_CONTEXT_LINES=12
PRACTICE_IMAGE_CONTEXT_FRAMES=3
PRACTICE_IMAGE_DUPLICATE_THRESHOLD=0.012

# Optional bounded local audio debug buffer. Keep at 0 for normal use.
AUDIO_DEBUG_BUFFER_SECONDS=0

# OFF by default. Enable only for permitted practice/coaching sessions.
PRACTICE_MODE=0

OVERLAY_MOUSE_PASSTHROUGH=1
