# quntumnintent Environment Variables Template
# Copy this file to '.env' and fill in your keys.

# NVIDIA key used for BOTH Parakeet ASR and GLM-5.2 text coaching.
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA Parakeet / Riva Speech-to-Text
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_RIVA_LANGUAGE=en-US

# Low-latency tuning. 0.56s is the local end-of-utterance silence target.
PARAKEET_ENDPOINT_SECONDS=0.56
PARAKEET_VAD_THRESHOLD=0.005
PARAKEET_MAX_UTTERANCE_SECONDS=20

# NVIDIA text model for practice / explicitly permitted AI-assisted sessions.
NVIDIA_INTEGRATE_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=z-ai/glm-5.2
NVIDIA_TEXT_MAX_TOKENS=256

# Automatic speech -> GLM coaching is OFF by default.
# Enable only for mock interviews/practice or sessions where AI help is allowed.
PRACTICE_MODE=0

# Optional: existing vision feature remains on Gemini because GLM-5.2 is text-only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash
