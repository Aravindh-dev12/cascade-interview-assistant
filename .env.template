# quntumnintent environment template
# Copy to .env and replace placeholders with your own credentials.
# Automatic coaching is intended only for mock interviews/practice or sessions where AI help is explicitly permitted.

# AI runtime
# auto    = prefer local Ollama when the selected model is installed, otherwise use Gemini
# ollama  = local-only
# gemini  = cloud-only
AI_PROVIDER=auto

# Recommended local coding + vision model (~3.4 GB Q4_K_M in Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
LOCAL_TEXT_MAX_TOKENS=700
LOCAL_VISION_MAX_TOKENS=1600

# NVIDIA Nemotron / Riva streaming ASR
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_RIVA_LANGUAGE=en-US

# Speech endpointing. Around 0.35-0.45s gives a responsive stop-speaking -> answer path.
ASR_ENDPOINT_SECONDS=0.40
ASR_VAD_THRESHOLD=0.005
ASR_MAX_UTTERANCE_SECONDS=30

# Optional Gemini fallback for text + vision
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEXT_MAX_TOKENS=700
GEMINI_VISION_MAX_TOKENS=1600
GEMINI_THINKING_BUDGET=0

TRANSCRIPT_CONTEXT_LINES=12
PRACTICE_IMAGE_CONTEXT_FRAMES=3
PRACTICE_IMAGE_DUPLICATE_THRESHOLD=0.012

# Optional bounded local audio debug buffer. Keep at 0 for normal use.
AUDIO_DEBUG_BUFFER_SECONDS=0

# OFF by default. Enable only for permitted practice/coaching sessions.
PRACTICE_MODE=0

# Existing overlay mouse-passthrough helper.
OVERLAY_MOUSE_PASSTHROUGH=1
