# quntumnintent environment template
# Copy to .env and replace placeholders with your own credentials.
# Automatic coaching is intended only for mock interviews/practice or sessions where AI help is explicitly permitted.

# AI runtime
# hybrid  = NVIDIA Kimi K3 first, local Qwen fallback (recommended)
# nvidia  = NVIDIA Kimi K3 only
# auto    = hybrid when NVIDIA_API_KEY exists, otherwise existing local-first routing
# ollama  = local Qwen/Ollama only
# gemini  = Gemini cloud only
AI_PROVIDER=hybrid

# Local fallback: Qwen3.5 4B
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
LOCAL_TEXT_MAX_TOKENS=700
LOCAL_VISION_MAX_TOKENS=1200

# NVIDIA credential shared by streaming Riva/Nemotron ASR and Kimi K3.
# Never commit a real key. If a key was pasted into chat/source, revoke it and create a new one.
NVIDIA_API_KEY=nvapi-REPLACE-WITH-A-NEW-ROTATED-KEY

# NVIDIA Kimi K3 reasoning + vision via OpenAI-compatible Chat Completions.
NVIDIA_KIMI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_KIMI_MODEL=moonshotai/kimi-k3
# low is recommended for real-time TTFT; use high/max only for manual deep questions.
NVIDIA_KIMI_REASONING_EFFORT=low
NVIDIA_KIMI_MAX_TOKENS=1200
NVIDIA_KIMI_TEMPERATURE=0.2
# In hybrid mode, fall back to local Qwen if the cloud stream stalls.
NVIDIA_KIMI_TIMEOUT_SECONDS=2.5

# NVIDIA Nemotron / Riva streaming ASR for microphone + system audio.
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_RIVA_LANGUAGE=en-US

# Low-latency speech endpointing.
ASR_ENDPOINT_SECONDS=0.35
ASR_VAD_THRESHOLD=0.005
ASR_MAX_UTTERANCE_SECONDS=30

# Windows default-speaker loopback capture rate for browser/video/meeting audio.
WASAPI_LOOPBACK_SAMPLE_RATE=48000

# Optional Gemini fallback when using AI_PROVIDER=gemini/auto without NVIDIA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEXT_MAX_TOKENS=700
GEMINI_VISION_MAX_TOKENS=1200
GEMINI_THINKING_BUDGET=0

TRANSCRIPT_CONTEXT_LINES=12
PRACTICE_IMAGE_CONTEXT_FRAMES=3
PRACTICE_IMAGE_DUPLICATE_THRESHOLD=0.012

# Optional bounded local audio debug buffer. Keep at 0 for normal use.
AUDIO_DEBUG_BUFFER_SECONDS=0

# OFF by default. Enable only for permitted practice/coaching sessions.
PRACTICE_MODE=0

OVERLAY_MOUSE_PASSTHROUGH=1
