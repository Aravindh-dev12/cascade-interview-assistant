# quntumnintent Environment Variables Template
# Copy this file to '.env' and fill in your keys.

# NVIDIA Parakeet / Riva Speech-to-Text
# Required for all audio transcription.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_RIVA_LANGUAGE=en-US

# Google Gemini API Key (Optional, for non-STT AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, for non-STT features only)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
