# quntumnintent Environment Variables Template
# Copy this file to '.env' and fill in your keys.

# OpenAI API Key (Required for Whisper STT and GPT-4o Vision/Chat)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional, if you wish to use Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Optional, if you wish to use Gemini 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here
