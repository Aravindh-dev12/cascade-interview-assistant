# quntumnintent Environment Variables Template
# Copy this file to '.env' and fill in your keys.

# NVIDIA key: speech-to-text only (Nemotron ASR Streaming)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_RIVA_LANGUAGE=en-US

# Low-latency speech endpointing
ASR_ENDPOINT_SECONDS=0.50
ASR_VAD_THRESHOLD=0.005
ASR_MAX_UTTERANCE_SECONDS=20

# Gemini key: answer generation only
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEXT_MAX_TOKENS=384
GEMINI_FAST_MIN_CHARS=120
GEMINI_FAST_MAX_CHARS=700
GEMINI_VISION_MAX_TOKENS=768

# Automatic speech/screen -> answer is OFF by default.
# Enable only for mock interviews/practice or sessions where AI help is explicitly allowed.
PRACTICE_MODE=0

# Overlay mouse passthrough
OVERLAY_MOUSE_PASSTHROUGH=1
