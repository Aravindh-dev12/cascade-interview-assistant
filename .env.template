# quntumnintent environment template
# Copy this file to .env and set your own API credentials locally.
# Never commit real API keys.
# Use this assistant only for mock interviews/practice or sessions where AI help is explicitly permitted.

# Final answer engine: Google Gemini 2.5 Flash only.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=REPLACE-WITH-YOUR-GOOGLE-GEMINI-API-KEY
GEMINI_TEMPERATURE=0.15
# Coding/debugging gets a modest thinking budget for stronger hidden/edge-case reasoning.
GEMINI_CODING_THINKING_BUDGET=1024
GEMINI_VISUAL_THINKING_BUDGET=256
TEXT_MAX_TOKENS=900
VISION_MAX_TOKENS=1800

# NVIDIA credential: Parakeet ASR + Nemotron Omni visual extraction.
NVIDIA_API_KEY=nvapi-REPLACE-WITH-A-NEW-ROTATED-KEY

# NVIDIA Parakeet CTC 1.1B English streaming ASR.
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_RIVA_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_RIVA_LANGUAGE=en-US

# NVIDIA Nemotron 3 Nano Omni image-to-text / visual extraction.
# If this service is busy/unavailable, the captured image history is sent directly to Gemini 2.5 Flash.
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_VISION_TIMEOUT_SECONDS=30.0
NVIDIA_VISION_POLL_TIMEOUT_SECONDS=40.0
NVIDIA_VISION_POLL_INTERVAL_SECONDS=0.5
NVIDIA_VISION_MAX_TOKENS=1800
NVIDIA_VISION_TEMPERATURE=0.1
NVIDIA_VISION_TOP_K=1
NVIDIA_VISION_MIN_USEFUL_CHARS=32
NVIDIA_VISION_429_BACKOFF_SECONDS=60.0
NVIDIA_VISION_503_RETRIES=3
NVIDIA_VISION_503_RETRY_DELAY_SECONDS=0.8

# Private candidate/resume/project context.
# These source files are git-ignored. At runtime they are imported into a private
# SQLite context store outside the repository. On Windows, chunk contents are
# encrypted at rest with the current Windows user's DPAPI credentials.
CANDIDATE_CONTEXT_FILE=data/candidate_context.local.md
CANDIDATE_PROJECTS_FILE=data/candidate_projects.local.md
CANDIDATE_CONTEXT_MAX_CHARS=30000
PRIVATE_CONTEXT_MAX_CHUNKS=8
PRIVATE_CONTEXT_MAX_CHARS=18000
# Optional override. Leave blank to use %LOCALAPPDATA%\quntumnintent\candidate_context.local.db
PRIVATE_CONTEXT_DB=

# Manual-first controls.
# Listen starts only when the Listen button/hotkey is pressed and stops when Stop is pressed.
# Screen analysis runs only from Capture screen / Ctrl+Shift+S. No background screenshot inference.
AUTO_VISUAL_ANSWER=0

# Low-latency speech endpointing.
ASR_ENDPOINT_SECONDS=0.35
ASR_VAD_THRESHOLD=0.005
ASR_MAX_UTTERANCE_SECONDS=30
WASAPI_LOOPBACK_SAMPLE_RATE=48000

TRANSCRIPT_CONTEXT_LINES=12
# Repeated manual captures can represent one long scrolled problem.
PRACTICE_IMAGE_CONTEXT_FRAMES=6
PRACTICE_VISUAL_TEXT_HISTORY=6
PRACTICE_IMAGE_DUPLICATE_THRESHOLD=0.012
AUDIO_DEBUG_BUFFER_SECONDS=0

# OFF by default. Enable only for permitted practice/coaching sessions.
PRACTICE_MODE=0

OVERLAY_MOUSE_PASSTHROUGH=1
